# ── Mahesh OS — optional environment ──────────────────────────────
# Copy this file to `.env.local` and fill in what you want to enable.
# Everything works WITHOUT these (the app falls back gracefully).

# Cloud persistence. Without it the dashboard still runs, but it is
# localStorage-only: nothing syncs, and /api/dashboard/load returns 500.
# This must also be set in the Vercel project's Environment Variables.
MONGODB_URI=

# AI Assistant — set this to use real Claude responses instead of the
# built-in context-aware simulation. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# GitHub contributions widget (public data; a token only raises rate limits)
# NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# LeetCode stats widget (public profile)
# NEXT_PUBLIC_LEETCODE_USERNAME=your-leetcode-username
